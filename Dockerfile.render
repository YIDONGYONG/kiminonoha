# Render（本番）用のDockerfile。開発用の Dockerfile とは別に管理する。
FROM ruby:3.2.5-slim

ENV RAILS_ENV=production \
    BUNDLE_DEPLOYMENT=1 \
    BUNDLE_WITHOUT="development:test" \
    LANG=C.UTF-8 \
    TZ=Asia/Tokyo \
    RAILS_LOG_TO_STDOUT=1

WORKDIR /rails

# ビルドツール・PostgreSQLクライアントライブラリ・Node.js（esbuild用）・yarn を導入
RUN apt-get update -qq \
 && apt-get install -y --no-install-recommends build-essential libpq-dev libyaml-dev curl ca-certificates gnupg \
 && curl -fsSL https://deb.nodesource.com/setup_lts.x | bash - \
 && apt-get install -y --no-install-recommends nodejs \
 && npm install --global yarn \
 && rm -rf /var/lib/apt/lists/*

# 依存関係を先にインストールしてビルドキャッシュを効かせる
COPY Gemfile Gemfile.lock ./
RUN bundle install

COPY package.json yarn.lock ./
RUN yarn install --frozen-lockfile

COPY . .

# JS・CSSのビルドとアセットのプリコンパイル（DBへは接続しないのでダミーの鍵を使う）
RUN SECRET_KEY_BASE_DUMMY=1 bundle exec rails assets:precompile

# Renderは環境変数 PORT で待ち受けポートを指定する
EXPOSE 10000
CMD ["bin/render-start"]
