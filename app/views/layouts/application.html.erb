<!DOCTYPE html>
<html>
  <head>
  
    <!-- ページタイトル（各ビューから動的に上書き可能） -->
    <title><%= content_for(:title) || "Brain Awakening" %></title>
    
    <!-- レスポンシブ対応およびPWA基本設定 -->
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    
    <!-- セキュリティ対策（CSRF保護） -->
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <!-- ページごとの個別ヘッドタグ拡張用フック -->
    <%= yield :head %>

    <!-- ブラウザータブ用ファビコン設定 (파일이 없을 경우 에러 방지를 위해 주석 처리) -->
    <%#= favicon_link_tag 'favicon-spark.png', rel: 'icon', type: 'image/png' %>

    <!-- アセット読み込み（Tailwind CSS / アプリケーション共通） -->
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", defer: true %>
  </head>
  
  <body>
    <!-- メインコンテンツ領域（画面中央配置） -->
    <main class="container mx-auto px-5 flex items-center justify-center min-h-screen">
      <%= yield %>
    </main>
  </body>
</html>